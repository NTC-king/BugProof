{
  "name": "bugproof-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/domain.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "evaluate:fixtures": "node tests/browser.mjs --evaluate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "pyodide": "314.0.7" },
  "devDependencies": { "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "typescript": "~5.9.3", "vite": "8.3.5", "playwright": "^1.56.0" }
}
