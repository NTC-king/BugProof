{
  "name": "bugproof-local",
  "version": "0.3.2",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/main.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:unit": "node --test tests/domain.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "evaluate:fixtures": "node tests/browser.mjs --evaluate",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server runner tests index.html tsconfig.json package.json",
    "format:check": "prettier --check src server runner tests index.html tsconfig.json package.json"
  },
  "dependencies": {
    "pyodide": "314.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.56.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  }
}
