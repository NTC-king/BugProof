    "source": "def median(values):\n    ordered = sorted(values)\n    n = len(ordered)\n    if not n:\n        raise ValueError(\"empty input\")\n    if n % 2:\n        return ordered[n // 2]\n    return (ordered[n // 2 - 1] + ordered[n // 2]) / 2\n",
